-- Information block for the plugin
PluginInfo = {
  Name = "Matty~Password~Expanded Password",
  Version = "2.0",
  BuildVersion = "2.2.0.0",
  Id = "9ed61e2c-9b4a-4412-879f-1961e3a541ea",
  Description = "Full customizable keyboard with custom buttons",
  Model = "Expanded Password",
  Author = "Matty"
}

rdxlogo = ""

sig = ""

print("RedNeck Math")

-- Define the color of the plugin object in the design
function GetColor(props)
  return { 155, 66, 245 }
end

-- The name that will initially display when dragged into a design
function GetPrettyName(props)
  return "Expanded-Password, version " .. PluginInfo.Version
end

-- Define User configurable Properties of the plugin
function GetProperties()
  local props = {}
  table.insert(props, {
    Name = "Debug Print",
    Type = "enum",
    Choices = {"None", "Tx/Rx", "Tx", "Rx", "Function Calls", "All"},
    Value = "All"
  })
  return props
end


